  replica:
  - text: Ahoy, SpaceCowboy!
    playerSide: 1
  - text: Have you seen that shit?
    playerSide: 1
  - text: Are you pinging about that AI rebel?
    playerSide: 0
  - text: No!
    playerSide: 1
  - text: Have you seen the toilets?
    playerSide: 1
  - text: However, what about AI?
    playerSide: 1
  - text: Seem's like this chromed psycho is attacking us
    playerSide: 0
  - text: Prepare for the good old battle!
    playerSide: 0
  - text: 'Roger that. '
    playerSide: 1
